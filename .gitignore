### >>> Custom (project-specific) ignore rules >>>

# Data files
data/*.csv
data/*.tar
data/*.tar.gz
data/*.zip
data/*.json

# Training artifacts & large files
checkpoint/
mecab-ko-dic/
prediction/
outputs/
wandb/
.wandb/
logs/
nohup.out
*.pth
*.pt
*.safetensors

# Environment
.env

# Configs generated by scripts
src/configs/generate_config.ipynb
src/configs/*.yaml

# Allow specific file in outputs
!outputs/init.txt

### <<< Custom <<<


### >>> General ignore templates >>>

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

